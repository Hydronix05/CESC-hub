{
  "trailingSlash": false,
  "rewrites": [
  { "source": "/", "destination": "/index.html" },
  { "source": "/chat", "destination": "/chat.html" },
  { "source": "/chat/:slug", "destination": "/chat.html?c=:slug" },
  { "source": "/search", "destination": "/search.html" },
  { "source": "/u/:username", "destination": "/search.html?u=:username" },
  { "source": "/profiles", "destination": "/search.html" },
  { "source": "/games", "destination": "/games.html" },
  { "source": "/games/bloxdio", "destination": "/games/play.html?slug=bloxdio" },
  { "source": "/games/:slug", "destination": "/games/play.html?slug=:slug" },
  { "source": "/leaderboard", "destination": "/leaderboard.html" },
  { "source": "/wallet", "destination": "/wallet.html" },
  { "source": "/settings", "destination": "/settings.html" },
  { "source": "/notifications", "destination": "/notifications.html" },
  { "source": "/download", "destination": "/download.html" },
  { "source": "/login", "destination": "/login.html" },
  { "source": "/signup", "destination": "/signup.html" },
  { "source": "/timeout", "destination": "/timeout.html" },
  { "source": "/timeout", "destination": "/timeout.html" },
  { "source": "/onboarding", "destination": "/onboarding.html" },
  { "source": "/feedback", "destination": "/feedback.html" },
  { "source": "/pending", "destination": "/pending.html" },
  { "source": "/about", "destination": "/about.html" }
],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}